# HTCondor submit: 4-GPU MPI-sharded OPEN iSWAP 2Q1C channel run on qis4, self-verifying.
# Runs opensystem/run_open_iswap_2q1c_4gpu.sh: shards the 16 dressed |D_a><D_b| channel inputs of
# model_iswap_2q1c_open.json across 4 GPUs (4 states/rank), merges to global order, and VERIFIES
# bit-identity vs (a) the saved single-GPU dump and (b) a fresh in-job single-process run, then scores
# F_open. The authoritative results are written to the SHARED-STORAGE run dir
#   /nfs_scratch/kunnumbrath/lambda_4/4Q4C/opensystem/open_iswap_2q1c/
#   -> RESULTS_4gpu.txt , merged_4rank.txt , result_multi_4gpu.txt , S_gpu_multi_4gpu.txt
# so they can be verified later regardless of where Condor sandboxes.
#
# Submit FROM THE cuLinblad REPO ROOT (like interactive.sub):
#   condor_submit open_iswap_2q1c_4gpu.sub
# Prereq (already produced by the single-GPU run opensystem/run_open_iswap_2q1c.sh):
#   model_iswap_2q1c_open.json  and  cpp_iswap_2q1c_open_single.txt  in the run dir above.

universe   = vanilla
executable = /nfs_scratch/kunnumbrath/lambda_4/4Q4C/opensystem/run_open_iswap_2q1c_4gpu.sh

# qis4 = the only sm_120 (Blackwell) node the binary targets (8x RTX PRO 6000).
requirements = (TARGET.IsOttenComputer =?= True) && (TARGET.Machine == "qis4.hep.wisc.edu")

# Condor stdout/stderr/log land in the submit dir (cuLinblad root), like interactive.sub. The
# authoritative, self-verifying results are written by the script to the shared run dir (see header).
log    = open_iswap_2q1c_4gpu.log
output = open_iswap_2q1c_4gpu.out
error  = open_iswap_2q1c_4gpu.err

# The script writes all results to ABSOLUTE paths on shared /nfs_scratch (not the sandbox), so there
# are no sandbox output files to bring back: transfer nothing (stdout/err/log above are separate and
# always returned on exit). Leaving should_transfer_files at its default keeps the job matchable both
# on a shared-FS execute node and via file transfer (like interactive.sub).
transfer_output_files = ""

+WantGPULab   = true
+GPUJobLength = "medium"

# request_gpus MUST equal NRANKS in the script (default 4) -> 4 distinct GPUs, one MPI rank each.
# request_cpus = 8: ~2 cpus/rank during the sharded evolve + room for the -t8 Julia scoring stage.
# (qis4 has far more than 8 cores, so this matches easily; raise toward 16 only if you want more slack.)
request_gpus   = 4
request_cpus   = 8
request_memory = 131072
request_disk   = 20000000

queue
