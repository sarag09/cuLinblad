# HTCondor: build the checkpoint-enabled fp32 solver on qis4 (GPU node, has the CUDA driver so the
# CUDA-aware MPICH links) and validate checkpoint+resume bit-identically on a small 2Q1C open model.
# 1 GPU is only needed for the validation run_sim (the build itself needs the node's driver libs).
# Report -> /nfs_scratch/kunnumbrath/cuLinblad/ckpt_validation_results.txt
#   condor_submit /nfs_scratch/kunnumbrath/cuLinblad/ckpt_validate.sub
universe   = vanilla
executable = /nfs_scratch/kunnumbrath/cuLinblad/ckpt_build_validate.sh

requirements = (TARGET.IsOttenComputer =?= True) && (TARGET.Machine == "qis4.hep.wisc.edu")

log    = /nfs_scratch/kunnumbrath/cuLinblad/ckpt_validate.log
output = /nfs_scratch/kunnumbrath/cuLinblad/ckpt_validate.out
error  = /nfs_scratch/kunnumbrath/cuLinblad/ckpt_validate.err
transfer_output_files = ""

request_gpus   = 1
request_cpus   = 8
request_memory = 16384
request_disk   = 8000000

queue
