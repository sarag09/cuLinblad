#!/usr/bin/env bash
# Build/run environment for cuLindblad.  Copy to setup_env.sh and edit the paths for your site:
#   cp setup_env.sh.example setup_env.sh && $EDITOR setup_env.sh
# Then:  source setup_env.sh
#
# Requirements: an NVIDIA HPC SDK (or CUDA Toolkit) that provides CUDA + cuTENSOR + cuBLAS,
# an MPI, and a PETSc built with COMPLEX scalars + CUDA (PETSC_ARCH=arch-cuda-complex).

# --- CUDA / cuTENSOR (a tree containing bin/, lib64/, and cuTENSOR headers+libs) -----------
export CUDA_MERGED=/path/to/cuda            # e.g. CUDA 13.x core + math_libs + cuTENSOR, co-located
export CUDAToolkit_ROOT="$CUDA_MERGED"

# --- PETSc (built with --with-scalar-type=complex --with-cuda) ----------------------------
export PETSC_DIR=/path/to/petsc
export PETSC_ARCH=arch-cuda-complex

# --- GPU compute capability of the target device (no leading "sm_"): e.g. 90=H100, 120=Blackwell
export CULINDBLAD_CUDA_ARCH=120

# Ensure core system dirs are on PATH (batch schedulers can start with an empty PATH, which
# breaks gcc/gfortran finding cc1/f951).
case ":$PATH:" in *":/usr/bin:"*) ;; *) PATH="${PATH:+$PATH:}/usr/bin:/bin:/usr/local/bin" ;; esac
unset GCC_EXEC_PREFIX COMPILER_PATH
export PATH="$PETSC_DIR/$PETSC_ARCH/bin:$CUDA_MERGED/bin:$PATH"
export PKG_CONFIG_PATH="$PETSC_DIR/$PETSC_ARCH/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
# NOTE: keep only PETSc + CUDA here. Do NOT add /usr/lib64 (or other system lib
# dirs): they are already in the default ld.so search path, and forcing them onto
# LD_LIBRARY_PATH can make a co-located Julia load an OLDER system libstdc++ ahead
# of its newer bundled one -> SIGSEGV in LLVM codegen when running Julia models.
export LD_LIBRARY_PATH="$PETSC_DIR/$PETSC_ARCH/lib:$CUDA_MERGED/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
